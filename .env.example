# Αυτές οι μεταβλητές δημιουργούνται αυτόματα όταν συνδέσεις μια βάση
# Vercel Postgres / Neon στο project σου στο Vercel (tab "Storage").
# Για τοπική ανάπτυξη, βάλε εδώ το connection string του Postgres σου.
POSTGRES_PRISMA_URL="postgres://user:password@host/dbname?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgres://user:password@host/dbname?sslmode=require"

# Μυστικό κλειδί για την υπογραφή των session cookies (βάλε μια τυχαία, μεγάλη τιμή)
JWT_SECRET="change-me-to-a-long-random-string"
